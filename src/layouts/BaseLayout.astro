---
import '../styles/global.css';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const pageTitle = title ? `${title} · dashgin` : 'dashgin.control — Dashgin Khudiyev';
const desc = description || 'Software engineer — Python & Django backends, applied AI, self-hosted infrastructure.';
const path = Astro.url.pathname;
const isActive = (p) => path.startsWith(base + p);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230b0e14'/><circle cx='50' cy='50' r='14' fill='%233ddc97'/></svg>" />
  </head>
  <body>
    <div class="wrap">
      <header class="statusbar panel">
        <span class="dot dot--pulse"></span>
        <a class="ok" href={base}>dashgin.control</a>
        <span class="sep">·</span>
        <span class="faint" id="clock">--:--:--</span>
        <span class="right">
          <a href={`${base}projects`} class={isActive('projects') ? 'active' : ''}>services</a>
          <a href={`${base}blog`} class={isActive('blog') ? 'active' : ''}>field reports</a>
          <a href="https://github.com/dashgin">github</a>
          <a href="https://linkedin.com/in/dashgin-khudiyev">linkedin</a>
          <a class="btn" href={`${base}resume.pdf`}>cv.pdf</a>
        </span>
      </header>

      <slot />

      <footer class="statusbar panel">
        <span class="faint">© {year} dashgin · built with astro · no trackers</span>
        <span class="right"><span class="dot"></span><span class="faint">status: shipping</span></span>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const clock = document.getElementById('clock');
        const tick = () => { clock.textContent = new Date().toLocaleTimeString('en-GB'); };
        tick(); setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
